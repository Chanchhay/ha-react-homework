# Copy to /etc/systemd/system/react-app.service on EACH web VM.
# Create non-root user 'reactapp' and copy app files to /opt/react-app.
# Set SERVER_ID and WEB_IP to the matching VM values.
[Unit]
Description=Highly Available React Dashboard HTTP Server
After=network.target

[Service]
Type=simple
User=reactapp
Group=reactapp
WorkingDirectory=/opt/react-app
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SERVER_ID=WEB-01
Environment=WEB_IP=192.168.56.20
ExecStart=/usr/bin/node /opt/react-app/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
